    {"tag": "trebuie-sa", "group": "modal", "label": "Trebuie să",
     "examples": ["**Trebuie să plec** acum.", "Ana **trebuie să lucreze** sâmbătă.", "Nu **trebuie să vii** mâine."]},
    {"tag": "modal-putea", "group": "modal", "label": "A putea — pot veni / pot să vin",
     "examples": ["Nu **pot veni** mâine.", "**Pot să intru**?", "Aici **putem parca** gratuit."]},
    {"tag": "conditional", "group": "modal", "label": "Condiționalul — aș vrea",
     "examples": ["**Aș vrea** o cafea, vă rog.", "**Ați putea** repeta, vă rog?", "**Am vrea** o masă pentru doi."]},
    {"tag": "conditional-perfect", "group": "modal", "label": "Condiționalul perfect — aș fi venit",
     "examples": ["**Aș fi venit**, dar am fost bolnav.", "**Am fi plecat** mai devreme.",
                  "Ce **ai fi făcut** în locul meu?"]},
    {"tag": "daca-ipotetic", "group": "modal", "label": "Dacă aș…, aș…",
     "examples": ["**Dacă aș avea** timp, **aș găti** mai des.", "**Dacă ar ploua**, **am sta** acasă.",
                  "Ce **ai face dacă ai câștiga** la loto?"]},
    {"tag": "imperfect-ipotetic", "group": "modal", "label": "Dacă știam, veneam",
     "examples": ["**Dacă știam**, **veneam** mai devreme.", "**Dacă plecai** la timp, nu **pierdeai** trenul.",
                  "**Dacă aveam** bani, **cumpăram** casa."]},

    {"tag": "imperativ", "group": "imperative", "label": "Imperativul — vino!",
     "examples": ["**Închide** fereastra, te rog!", "**Vino** aici!", "**Luați** loc, vă rog."]},
    {"tag": "imperativ-negativ", "group": "imperative", "label": "Imperativul negativ — nu pleca! / nu plecați!",
     "examples": ["**Nu pleca** încă!", "**Nu uita** cheile!", "**Nu fumați** aici, vă rog."]},
    {"tag": "imperativ-clitic", "group": "imperative", "label": "Imperativ + pronume — dă-mi, uită-te",
     "examples": ["**Dă-mi** numărul tău, te rog.", "**Uită-te** aici!", "**Spune-i** că vin imediat."]},

    {"tag": "clitic-acuzativ", "group": "pronouns", "label": "Pronume în acuzativ — l-am văzut",
     "examples": ["**L-am sunat** ieri.", "Unde e cheia? **O caut** de o oră.", "Cartea? **Am citit-o** deja."]},
    {"tag": "pe-acuzativ", "group": "pronouns", "label": "Pe + persoană — o aștept pe Ana",
     "examples": ["**O aștept pe Ana** la gară.", "**Îl cunoști pe Mihai**?", "**Pe cine** cauți?"]},
    {"tag": "clitic-dativ", "group": "pronouns", "label": "Pronume în dativ — îi dau",
     "examples": ["**Îi trimit** un mesaj mamei.", "Ana **mi-a dat** o carte.", "Ce **le spui** copiilor?"]},
    {"tag": "dativ-experimentator", "group": "pronouns", "label": "Îmi place, mi-e frig",
