    {"tag": "reflexiv-acuzativ", "group": "reflexive", "label": "Verbe reflexive (acuzativ) — mă trezesc",
     "examples": ["**Mă pregătesc** de plecare.", "La ce oră **te trezești**?", "Copiii **se joacă** afară."]},
    {"tag": "reflexiv-dativ", "group": "reflexive", "label": "Verbe reflexive (dativ) — îmi amintesc",
     "examples": ["**Îmi amintesc** adresa.", "**Mi-am cumpărat** o bicicletă.", "Ana **își dorește** un câine."]},
    {"tag": "se-impersonal", "group": "reflexive", "label": "Se poate, se spune",
     "examples": ["**Se poate** plăti cu cardul?", "Aici nu **se fumează**.", "Cum **se spune** asta în română?"]},

    {"tag": "comparativ", "group": "sentences", "label": "Mai … decât, cel mai",
