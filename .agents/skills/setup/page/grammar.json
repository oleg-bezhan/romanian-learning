    {"tag": "dativ-posesiv", "group": "pronouns", "label": "Dativul posesiv — mi s-a stricat telefonul",
     "examples": ["**Mi s-a stricat** telefonul.", "**I-am cunoscut** părinții ieri.",
                  "**Mi-a furat** cineva portofelul."]},
    {"tag": "clitice-combinate", "group": "pronouns", "label": "Două pronume — mi l-a dat",
