# Settings for the Romanian cards. The setup skill fills this in with you.
# Keep this file private: it holds your ElevenLabs key.

# --- ElevenLabs (the voice that reads the Romanian aloud) ---
# Paste your key after the = sign, with no spaces, then save the file.
ELEVENLABS_API_KEY=
# The voice to use. The setup skill helps you choose one.
ELEVENLABS_VOICE_ID=

# --- Anki ---
# The deck new cards go into, and the note type (both must exist in Anki).
ANKI_IMPORT_DECK=
ANKI_MODEL=Basic
# Anki's media folder. The setup skill finds it for you.
ANKI_MEDIA_DIR=
# Leave these unless your note type uses other field names.
ANKI_FRONT_FIELD=Front
ANKI_BACK_FIELD=Back
# Where AnkiConnect listens. Leave as is.
ANKI_CONNECT_URL=http://127.0.0.1:8765

# --- Safety nets ---
# A daily backup of your deck is saved here before cards are added.
ANKI_BACKUP_DIR=backups
# Ask before a batch whose audio would cost this many characters or more.
TTS_CONFIRM_CHARS=3000
